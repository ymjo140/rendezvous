# Frontend: copy to .env.local. Empty API URL uses the local same-origin proxy.
NEXT_PUBLIC_API_URL=
LOCAL_API_PROXY=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_SENTRY_LOADER_URL=

# Backend: generate your own SECRET_KEY. Use a separate development PostgreSQL
# database with pgvector; SQLite is supported only by the focused test suite.
SECRET_KEY=
DATABASE_URL=postgresql://localhost/rendezvous_dev
APP_ENV=local

# Never enable these on a deployed/shared database. Only APP_ENV=test + a local
# database + explicitly listed user IDs permit mock credits. Spending stays off.
MOCK_PAYMENTS_ENABLED=false
MOCK_PAYMENT_USER_IDS=

# Optional provider integrations (leave blank to work on local API tests).
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/callback/kakao
GEMINI_API_KEY=
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=
NAVER_MAP_ID=
NAVER_MAP_SECRET=
ODSAY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SENTRY_DSN=
